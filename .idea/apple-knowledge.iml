  <component name="RakeTasksCache">
    <option name="myRootTask">
      <RakeTaskImpl id="rake">
        <subtasks>
          <RakeTaskImpl description="update credits file from all repos" fullCommand="credits" id="credits" />
          <RakeTaskImpl id="data">
            <subtasks>
              <RakeTaskImpl id="baseband">
                <subtasks>
                  <RakeTaskImpl id="bbcfg">
                    <subtasks>
                      <RakeTaskImpl description="pull out blobs from a bbcfg" fullCommand="data:baseband:bbcfg:qc_blobs[file]" id="qc_blobs[file]" />
                      <RakeTaskImpl description="" fullCommand="data:baseband:bbcfg:qc_blobs" id="qc_blobs" />
                    </subtasks>
                  </RakeTaskImpl>
                  <RakeTaskImpl description="extract all baseband firmwares to tmp" fullCommand="data:baseband:extract[directory]" id="extract[directory]" />
                  <RakeTaskImpl description="" fullCommand="data:baseband:extract" id="extract" />
                </subtasks>
              </RakeTaskImpl>
              <RakeTaskImpl id="boot_args">
                <subtasks>
                  <RakeTaskImpl description="update boot-args from XNU source tree" fullCommand="data:boot_args:scan_xnu_source[xnu_directory]" id="scan_xnu_source[xnu_directory]" />
                  <RakeTaskImpl description="" fullCommand="data:boot_args:scan_xnu_source" id="scan_xnu_source" />
                </subtasks>
              </RakeTaskImpl>
              <RakeTaskImpl description="update device files from device trees" fullCommand="data:device_tree" id="device_tree" />
              <RakeTaskImpl id="entitlements">
                <subtasks>
                  <RakeTaskImpl description="scan directory of plists and add to entitements database" fullCommand="data:entitlements:scan[directory]" id="scan[directory]" />
                  <RakeTaskImpl description="" fullCommand="data:entitlements:scan" id="scan" />
                </subtasks>
              </RakeTaskImpl>
              <RakeTaskImpl description="update firmwares from example manifests in tmp/build_manifests" fullCommand="data:firmware" id="firmware" />
              <RakeTaskImpl id="ipsw">
                <subtasks>
                  <RakeTaskImpl description="download device trees from IPSWs from local store" fullCommand="data:ipsw:dt[dir]" id="dt[dir]" />
                  <RakeTaskImpl description="update hashes for IPSW from shasum file" fullCommand="data:ipsw:hashes[shasums]" id="hashes[shasums]" />
                  <RakeTaskImpl description="invalid IPSWs from local store" fullCommand="data:ipsw:invalid[dir]" id="invalid[dir]" />
                  <RakeTaskImpl description="process ipsw manifests" fullCommand="data:ipsw:manifests" id="manifests" />
                  <RakeTaskImpl id="manifests">
                    <subtasks>
                      <RakeTaskImpl description="download ipsw manifests" fullCommand="data:ipsw:manifests:download" id="download" />
                      <RakeTaskImpl description="download ipsw manifests from local store" fullCommand="data:ipsw:manifests:local[dir]" id="local[dir]" />
                      <RakeTaskImpl description="" fullCommand="data:ipsw:manifests:local" id="local" />
                    </subtasks>
                  </RakeTaskImpl>
                  <RakeTaskImpl description="create merkle tree from zip" fullCommand="data:ipsw:merkle[file]" id="merkle[file]" />
                  <RakeTaskImpl description="missing IPSWs from local store" fullCommand="data:ipsw:missing[dir]" id="missing[dir]" />
                  <RakeTaskImpl description="missing IPSWs that have URLs but no hashes" fullCommand="data:ipsw:missing_hashes[batch_size]" id="missing_hashes[batch_size]" />
                  <RakeTaskImpl description="total order each IPSW" fullCommand="data:ipsw:total_order" id="total_order" />
                  <RakeTaskImpl description="" fullCommand="data:ipsw:dt" id="dt" />
                  <RakeTaskImpl description="" fullCommand="data:ipsw:hashes" id="hashes" />
                  <RakeTaskImpl description="" fullCommand="data:ipsw:invalid" id="invalid" />
                  <RakeTaskImpl description="" fullCommand="data:ipsw:merkle" id="merkle" />
                  <RakeTaskImpl description="" fullCommand="data:ipsw:missing" id="missing" />
                  <RakeTaskImpl description="" fullCommand="data:ipsw:missing_hashes" id="missing_hashes" />
                </subtasks>
              </RakeTaskImpl>
              <RakeTaskImpl id="kexts">
                <subtasks>
                  <RakeTaskImpl description="handle dumpstate" fullCommand="data:kexts:dumpstate" id="dumpstate" />
                </subtasks>
              </RakeTaskImpl>
              <RakeTaskImpl description="integrate key file" fullCommand="data:keyfile" id="keyfile" />
              <RakeTaskImpl description="update launchd services from OS" fullCommand="data:launchd" id="launchd" />
              <RakeTaskImpl id="lockdownd">
                <subtasks>
                  <RakeTaskImpl description="scan lockdownd log for data update" fullCommand="data:lockdownd:example" id="example" />
                </subtasks>
              </RakeTaskImpl>
              <RakeTaskImpl description="Update files from MESU" fullCommand="data:mobile_assets" id="mobile_assets" />
              <RakeTaskImpl description="" fullCommand="data:fdr" id="fdr" />
              <RakeTaskImpl description="" fullCommand="data:ioreg" id="ioreg" />
              <RakeTaskImpl description="" fullCommand="data:kexts" id="kexts" />
              <RakeTaskImpl description="" fullCommand="data:macho" id="macho" />
              <RakeTaskImpl description="" fullCommand="data:mobile_gestalt" id="mobile_gestalt" />
              <RakeTaskImpl description="" fullCommand="data:vinyl" id="vinyl" />
            </subtasks>
          </RakeTaskImpl>
          <RakeTaskImpl description="default build task" fullCommand="default" id="default" />
          <RakeTaskImpl id="img4">
            <subtasks>
              <RakeTaskImpl description="Extract any img4 files in the tmp directory" fullCommand="img4:extract" id="extract" />
            </subtasks>
          </RakeTaskImpl>
          <RakeTaskImpl description="Build for deployment (but do not deploy)" fullCommand="jekyll" id="jekyll" />
          <RakeTaskImpl description="do all precommit tasks" fullCommand="precommit" id="precommit" />
          <RakeTaskImpl description="Run RuboCop" fullCommand="rubocop" id="rubocop" />
          <RakeTaskImpl id="rubocop">
            <subtasks>
              <RakeTaskImpl description="Autocorrect RuboCop offenses (only when it's safe)" fullCommand="rubocop:autocorrect" id="autocorrect" />
              <RakeTaskImpl description="Autocorrect RuboCop offenses (safe and unsafe)" fullCommand="rubocop:autocorrect_all" id="autocorrect_all" />
              <RakeTaskImpl description="" fullCommand="rubocop:auto_correct" id="auto_correct" />
            </subtasks>
          </RakeTaskImpl>
          <RakeTaskImpl description="sort everything" fullCommand="sort" id="sort" />
          <RakeTaskImpl description="sort single collection in data file" fullCommand="sort_collection[data_file,collection]" id="sort_collection[data_file,collection]" />
          <RakeTaskImpl id="stubs">
            <subtasks>
              <RakeTaskImpl description="create format stubs" fullCommand="stubs:formats" id="formats" />
            </subtasks>
          </RakeTaskImpl>
          <RakeTaskImpl id="tipw">
            <subtasks>
              <RakeTaskImpl description="update category listings" fullCommand="tipw:categories" id="categories" />
              <RakeTaskImpl description="update firmware codenames from TIPW" fullCommand="tipw:codenames" id="codenames" />
              <RakeTaskImpl description="update IPSWs from downloaded TIPW pages" fullCommand="tipw:ipsws" id="ipsws" />
              <RakeTaskImpl description="update keybags from TIPW pages in tmp/tipw/firmware_keys" fullCommand="tipw:keydb" id="keydb" />
              <RakeTaskImpl description="update keybags from keydb" fullCommand="tipw:keys" id="keys" />
              <RakeTaskImpl description="update raw data pages in tmp" fullCommand="tipw:pages[force]" id="pages[force]" />
              <RakeTaskImpl description="" fullCommand="tipw:pages" id="pages" />
            </subtasks>
          </RakeTaskImpl>
          <RakeTaskImpl description="Perform all automated updates" fullCommand="update" id="update" />
          <RakeTaskImpl description="validate data directory" fullCommand="validate" id="validate" />
          <RakeTaskImpl description="" fullCommand="sort_collection" id="sort_collection" />
        </subtasks>
      </RakeTaskImpl>
    </option>
