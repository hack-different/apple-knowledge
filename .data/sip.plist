			<key>disable_default</key>
			<true/>
			<key>value</key>
			<integer>64</integer>
		</dict>
		<key>CSR_ALLOW_UNTRUSTED_KEXTS</key>
		<dict>
			<key>description</key>
			<string>allow loading kernel extensions that are not signed</string>
			<key>disable_default</key>
			<true/>
			<key>value</key>
			<integer>1</integer>
		</dict>
