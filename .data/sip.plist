		</dict>
		<key>CSR_ALLOW_UNRESTRICTED_FS</key>
		<dict>
			<key>description</key>
			<string>disable SIP protections of various paths (such as write protection of /System)</string>
			<key>disable_default</key>
			<true/>
			<key>value</key>
			<integer>2</integer>
		</dict>
		<key>CSR_ALLOW_UNRESTRICTED_NVRAM</key>
		<dict>
			<key>description</key>
