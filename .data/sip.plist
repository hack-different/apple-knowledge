		<key>CSR_ALLOW_ANY_RECOVERY_OS</key>
		<dict>
			<key>always_enforced</key>
			<true/>
			<key>description</key>
			<string>disable validation of BaseSystem.dmg by ignoring BaseSystem.chunklist</string>
			<key>value</key>
			<integer>256</integer>
		</dict>
		<key>CSR_ALLOW_APPLE_INTERNAL</key>
		<dict>
			<key>description</key>
			<string>Allows for AppleInternal (non-production signed code)</string>
			<key>disable_default</key>
			<true/>
			<key>value</key>
			<integer>16</integer>
		</dict>
		<key>CSR_ALLOW_DEVICE_CONFIGURATION</key>
		<dict>
			<key>always_enforced</key>
			<true/>
			<key>description</key>
			<string>This indicates that the device is booted into a mode whereby `bputil` will allow changes</string>
			<key>value</key>
			<integer>128</integer>
		</dict>
		<key>CSR_ALLOW_EXECUTABLE_POLICY_OVERRIDE</key>
		<dict>
			<key>description</key>
			<string>override trust-cache or executable policy</string>
			<key>value</key>
			<integer>1024</integer>
		</dict>
		<key>CSR_ALLOW_KERNEL_DEBUGGER</key>
		<dict>
			<key>description</key>
			<string>allow using the kernel debugger (KDP) - requires configuring the kernel debugger via boot-args</string>
			<key>disable_default</key>
			<true/>
			<key>value</key>
			<integer>8</integer>
		</dict>
		<key>CSR_ALLOW_TASK_FOR_PID</key>
		<dict>
			<key>description</key>
			<string>allow getting the pid task, required for privileged debugging</string>
			<key>disable_default</key>
			<true/>
			<key>value</key>
			<integer>4</integer>
		</dict>
		<key>CSR_ALLOW_UNAPPROVED_KEXTS</key>
		<dict>
			<key>description</key>
			<string>do not require kext approval (managed in the T2 when it exists)</string>
			<key>value</key>
			<integer>512</integer>
		</dict>
		<key>CSR_ALLOW_UNAUTHENTICATED_ROOT</key>
		<dict>
			<key>description</key>
			<string>Permits the root filesystem to lack SSV (signed system volume) protection</string>
			<key>value</key>
			<integer>2048</integer>
		</dict>
		<key>CSR_ALLOW_UNRESTRICTED_DTRACE</key>
